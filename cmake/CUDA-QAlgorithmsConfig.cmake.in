@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET cudaq::cudaq)
  if(DEFINED CUDAQ_DIR)
    include("${CMAKE_CURRENT_LIST_DIR}/CUDA-QAlgorithms.cmake")
    cudaqa_import_cudaq_targets()
  else()
    find_dependency(CUDAQ CONFIG)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CUDA-QAlgorithmsTargets.cmake")

check_required_components(CUDA-QAlgorithms)
